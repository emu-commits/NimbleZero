# Runtime needed by unmodified M5Stack binaries (APPLaunch, AppStore, apps) + dpkg
BR2_PACKAGE_LIBCURL=y
BR2_PACKAGE_LIBCURL_CURL=y
# TLS for curl/wget: nz-m5 downloads packages over https (rc5 shipped curl without TLS)
BR2_PACKAGE_OPENSSL=y
BR2_PACKAGE_LIBOPENSSL_BIN=y
BR2_PACKAGE_LIBCURL_OPENSSL=y
BR2_PACKAGE_CA_CERTIFICATES=y
BR2_PACKAGE_FREETYPE=y
BR2_PACKAGE_LIBGLIB2=y
BR2_PACKAGE_LIBINPUT=y
BR2_PACKAGE_LIBXKBCOMMON=y
BR2_PACKAGE_XKEYBOARD_CONFIG=y
BR2_PACKAGE_SUDO=y
BR2_PACKAGE_BASH=y
BR2_PACKAGE_UTIL_LINUX=y
BR2_PACKAGE_UTIL_LINUX_BINARIES=y
BR2_TARGET_ROOTFS_EXT2_SIZE="768M"
BR2_PACKAGE_DPKG=y
BR2_PACKAGE_NZ_COMPAT=y
BR2_PACKAGE_PROCPS_NG=y
BR2_PACKAGE_WGET=y
BR2_PACKAGE_COREUTILS=y
BR2_PACKAGE_XORG7=y
BR2_PACKAGE_XLIB_LIBX11=y
BR2_PACKAGE_NZ_LAUNCHER=y
BR2_PACKAGE_HTOP=y
BR2_PACKAGE_NANO=y
BR2_ENABLE_LOCALE_WHITELIST="C en_US en_US.UTF-8 compose.dir locale.alias"
BR2_PACKAGE_DBUS=y
BR2_PACKAGE_NZ_APPS=y
# --- first public release: multimedia libraries the M5Stack apps depend on ---
BR2_PACKAGE_PULSEAUDIO=y
BR2_PACKAGE_PULSEAUDIO_DAEMON=y
BR2_PACKAGE_LIBV4L=y
BR2_PACKAGE_LIBV4L_UTILS=y
# ffmpeg configured like Debian's as far as Buildroot 2026.02.3 packages allow:
# GPL parts on, nonfree off (see docs/M5-COMPAT.md for what could not be matched)
BR2_PACKAGE_FFMPEG=y
BR2_PACKAGE_FFMPEG_GPL=y
BR2_PACKAGE_FFMPEG_FFMPEG=y
BR2_PACKAGE_FFMPEG_FFPROBE=y
BR2_PACKAGE_FFMPEG_POSTPROC=y
BR2_PACKAGE_FFMPEG_SWSCALE=y
BR2_PACKAGE_FFMPEG_ENCODERS="all"
BR2_PACKAGE_FFMPEG_DECODERS="all"
BR2_PACKAGE_FFMPEG_MUXERS="all"
BR2_PACKAGE_FFMPEG_DEMUXERS="all"
BR2_PACKAGE_FFMPEG_PARSERS="all"
BR2_PACKAGE_FFMPEG_BSFS="all"
BR2_PACKAGE_FFMPEG_PROTOCOLS="all"
BR2_PACKAGE_FFMPEG_FILTERS="all"
BR2_PACKAGE_FFMPEG_INDEVS=y
BR2_PACKAGE_FFMPEG_OUTDEVS=y
BR2_PACKAGE_X264=y
BR2_PACKAGE_X265=y
BR2_PACKAGE_LIBVPX=y
BR2_PACKAGE_DAV1D=y
BR2_PACKAGE_OPUS=y
BR2_PACKAGE_LAME=y
BR2_PACKAGE_LIBVORBIS=y
BR2_PACKAGE_LIBTHEORA=y
BR2_PACKAGE_SPEEX=y
BR2_PACKAGE_OPENJPEG=y
BR2_PACKAGE_LIBXML2=y
BR2_PACKAGE_LIBSOXR=y
BR2_PACKAGE_FONTCONFIG=y
BR2_PACKAGE_HARFBUZZ=y
BR2_PACKAGE_LIBFRIBIDI=y
BR2_PACKAGE_LIBASS=y
BR2_PACKAGE_LIBDRM=y
BR2_PACKAGE_BZIP2=y
# TLS for ffmpeg (https streams).  With the GPL parts on, ffmpeg may not link OpenSSL;
# GnuTLS is what Debian's ffmpeg uses too.
BR2_PACKAGE_GNUTLS=y
# --- Python for the M5 app index (most index apps are Python scripts) ---
BR2_PACKAGE_PYTHON3=y
BR2_PACKAGE_PYTHON3_SSL=y
BR2_PACKAGE_PYTHON3_SQLITE=y
BR2_PACKAGE_PYTHON3_ZLIB=y
BR2_PACKAGE_PYTHON3_BZIP2=y
BR2_PACKAGE_PYTHON3_XZ=y
BR2_PACKAGE_PYTHON3_CURSES=y
BR2_PACKAGE_PYTHON3_READLINE=y
BR2_PACKAGE_PYTHON3_PYEXPAT=y
BR2_PACKAGE_PYTHON3_UNICODEDATA=y
BR2_PACKAGE_PYTHON3_DECIMAL=y
BR2_PACKAGE_JPEG=y
BR2_PACKAGE_PYTHON_PILLOW=y
BR2_PACKAGE_PYTHON_NUMPY=y
BR2_PACKAGE_PYTHON_EVDEV=y
BR2_PACKAGE_PYTHON_QRCODE=y
BR2_PACKAGE_PYTHON_REQUESTS=y
# fonts the Pillow-based apps load (Debian: fonts-dejavu-core)
BR2_PACKAGE_DEJAVU=y
# --- PNG, JPEG (Debian's library name, see external.mk) and SDL2 for apps of the M5 index ---
BR2_PACKAGE_LIBPNG=y
BR2_PACKAGE_SDL2=y
BR2_PACKAGE_SDL2_TTF=y
BR2_PACKAGE_SDL2_IMAGE=y
BR2_PACKAGE_SDL2_MIXER=y
# --- camera: M5Stack Camera / FxCam link libcamera 0.8 (Raspberry Pi tree), fmt 10, cJSON ---
BR2_PACKAGE_NZ_LIBCAMERA=y
BR2_PACKAGE_NZ_FMT10=y
BR2_PACKAGE_CJSON=y
