#!/bin/sh
# SPDX-License-Identifier: GPL-2.0-only
# nz-app-remove FILE.desktop - remove the app behind a launcher entry (launcher: Del key).
# Finds the package that installed the entry, asks (with "No" preselected), then removes it
# through "sudo nz-admin store remove" like the Store does.  Entries that no package owns
# (NimbleZero's own apps) and packages that are part of the system are refused.
A="sudo -n /usr/sbin/nz-admin"; [ "$(id -u)" = 0 ] && A=/usr/sbin/nz-admin
f=$1
[ -f "$f" ] || { echo "nz-app-remove: no such entry: $f" >&2; exit 2; }
name=$(sed -n 's/^Name=//p' "$f" | head -n1); name=${name:-${f##*/}}
T=$(mktemp) || exit 1
trap 'rm -f "$T"' EXIT; trap 'exit 1' INT TERM HUP
say() { printf '%s\n' "$1" | fold -s -w 37 | sed 's/^/-/' >> "$T"; }
tell() {   # a message page with one "OK" row
	: > "$T"; say "$1"; echo "OK" >> "$T"; nz-pick "Remove $name" < "$T" >/dev/null; exit 0
}
pkg=$(dpkg-query -S "$f" 2>/dev/null | sed -n 's/^\([^:, ]*\): .*/\1/p' | head -n1)
[ -n "$pkg" ] || tell "$name is part of NimbleZero and cannot be removed."
st=$(dpkg-query -W -f='${db:Status-Abbrev}' "$pkg" 2>/dev/null)
case "$st" in h*) tell "$name is part of the system and cannot be removed." ;; esac
ver=$(dpkg-query -W -f='${Version}' "$pkg" 2>/dev/null)
# other launcher entries the same package installed go with it
others=$(dpkg-query -L "$pkg" 2>/dev/null | grep '/applications/.*\.desktop$' | while read -r d; do
	[ "$d" = "$f" ] || [ ! -f "$d" ] || sed -n 's/^Name=//p' "$d" | head -n1; done | awk 'NR > 1 { printf ", " } { printf "%s", $0 }')
: > "$T"
say "$name comes from the package $pkg $ver. It and its files are deleted from the device."
[ -n "$others" ] && say "Also removed with it: $others."
h=$(wc -l < "$T")
printf '%s\n' "No, keep it" "Yes, remove $name" >> "$T"
n=$(nz-pick "Remove $name?" < "$T") || exit 0
[ "$n" = $((h + 2)) ] || exit 0
clear 2>/dev/null
$A store remove "$pkg"
printf '\nPress Enter '; IFS= read -r _
