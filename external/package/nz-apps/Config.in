config BR2_PACKAGE_NZ_APPS
	bool "nz-apps (native example applications and launcher entries)"
	depends on BR2_PACKAGE_NZ_LAUNCHER
	help
	  Launcher entries (.desktop files) and small applications that
	  exercise the three application styles: a graphical nzui app
	  (snake), terminal programs (shell, htop when present)
	  and networking tools (Wi-Fi setup, network info, SSH client).
