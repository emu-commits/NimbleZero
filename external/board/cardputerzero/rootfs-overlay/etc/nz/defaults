# emuZero defaults for the Options settings (nz-admin reads this file; a choice made in
# Options, stored in /data/etc/nz, always wins).  Wi-Fi at start off (switch it on in
# Options > Wi-Fi when needed) and USB off (about 93 mA less), for battery life; emuZero is
# the launcher at start, and installing the M5 launcher does not change that.
wifi-boot=off
usb=off
launcher=emuzero
