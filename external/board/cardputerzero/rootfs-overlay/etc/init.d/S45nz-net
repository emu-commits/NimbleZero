#!/bin/sh
# Headless networking: Wi-Fi from /boot/wifi.conf or the Wi-Fi app, DHCP on USB Ethernet.
# Everything runs in the background so it never delays the console.
#
#   start      Ethernet, and Wi-Fi unless Options > Wi-Fi at start is off
#   stop       stop Wi-Fi (link down, radio idle)
#   wifi       start Wi-Fi now, whatever the boot setting says (nz-admin wifi-power on)
#   eth        DHCP on USB Ethernet once it appears (nz-admin usb on)
CONF=/data/etc/wpa_supplicant.conf

eth() {
	# the USB controller loads in the background (S13nz-usb), so the adapter may appear
	# a moment after this runs; wait for it while the controller is there
	n=0
	while [ ! -e /sys/class/net/eth0 ] && [ $n -lt 16 ]; do
		[ -e /sys/bus/platform/drivers/dwc2 ] || return 0
		sleep 0.5; n=$((n+1))
	done
	[ -e /sys/class/net/eth0 ] && udhcpc -b -q -i eth0 -x hostname:"$(hostname)" >/dev/null 2>&1
}

wifi() {
	# /boot/wifi.conf (edited on a PC) wins over what the Wi-Fi app saved
	[ -f /boot/wifi.conf ] && { tr -d '\r' < /boot/wifi.conf > $CONF; chmod 600 $CONF; }
	grep -q 'ssid=' $CONF 2>/dev/null || return 0
	# the Wi-Fi app and the Store ask wpa_supplicant for its state through the control
	# socket; a hand-written wifi.conf (like wifi.conf.example) has no ctrl_interface
	# line, and without it the Wi-Fi app shows "not connected" while wlan0 is online
	grep -q '^[[:space:]]*ctrl_interface=' $CONF || sed -i '1i ctrl_interface=/var/run/wpa_supplicant' $CONF
	n=0; while [ ! -e /sys/class/net/wlan0 ] && [ $n -lt 20 ]; do sleep 0.5; n=$((n+1)); done
	[ -e /sys/class/net/wlan0 ] || { echo "nz-net: wlan0 did not appear" > /dev/kmsg; return 1; }
	# regulatory domain chosen in the Options menu (channels and power for that country)
	c=$(cat /data/etc/nz/wifi-country 2>/dev/null); [ -n "$c" ] && iw reg set "$c" 2>/dev/null
	pidof wpa_supplicant >/dev/null 2>&1 && return 0
	ip link set wlan0 up 2>/dev/null
	wpa_supplicant -B -i wlan0 -c $CONF -P /run/wpa_supplicant.pid >/dev/null 2>&1
	udhcpc -b -i wlan0 -x hostname:"$(hostname)" -p /run/udhcpc.wlan0.pid >/dev/null 2>&1
}

wifi_stop() {
	[ -f /run/udhcpc.wlan0.pid ] && kill "$(cat /run/udhcpc.wlan0.pid)" 2>/dev/null
	[ -f /run/wpa_supplicant.pid ] && kill "$(cat /run/wpa_supplicant.pid)" 2>/dev/null
	# the Wi-Fi app may have started its own supplicant
	killall wpa_supplicant 2>/dev/null
	rm -f /run/udhcpc.wlan0.pid /run/wpa_supplicant.pid
	n=0; while pidof wpa_supplicant >/dev/null 2>&1 && [ $n -lt 20 ]; do sleep 0.1; n=$((n+1)); done
	ip addr flush dev wlan0 2>/dev/null
	ip link set wlan0 down 2>/dev/null
}

wifi_at_boot() { [ "$(nz-admin get wifi-boot 2>/dev/null)" != off ]; }

case "$1" in
start)
	(
		nz-admin apply-volume 2>/dev/null       # saved speaker volume (Options menu)
		eth &
		if wifi_at_boot; then wifi
		else ip link set wlan0 down 2>/dev/null; fi   # Options > Wi-Fi at start: off
	) & ;;
stop) wifi_stop ;;
restart) wifi_stop; sleep 1; wifi & ;;
wifi) wifi ;;
eth) eth & ;;
esac
