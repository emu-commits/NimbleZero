#!/bin/sh
# USB controller (USB-C port, hub, USB Ethernet), as chosen in Options > USB.
# /etc/modprobe.d/nz-usb.conf keeps udev from loading the driver by itself, because the
# setting lives on the data partition, which is mounted only after udev has started.
# Loading happens in the background: the controller takes about 0.7 s to start and
# nothing before the console needs it (the keyboard is on I2C).
case "$1" in
start) nz-admin usb apply >/dev/null 2>&1 & ;;
esac
