# Package lifecycle tests run inside the booted compat image (see tests/qemu-boot.py --script).
# Each line is "<test name> :: <shell command>"; the test passes when the command exits 0.
# /mnt is a USB stick image holding real upstream M5Stack .deb files plus the
# locally constructed nz-test-* packages (tests/compat/make-test-debs.sh).
mount debs :: : > /run/nz/nolauncher; killall nz-launcher 2>/dev/null; modprobe usb-storage; sleep 6; mkdir -p /mnt && mount -o ro /dev/sda /mnt && ls /mnt | wc -l
dpkg database seeded with firmware packages :: n=$(dpkg-query -W -f='${db:Status-Abbrev}${Package}\n' | grep -c '^hi'); echo "$n held firmware packages"; [ "$n" -ge 15 ] && dpkg --audit && dpkg-query -W libc6 libstdc++6
firmware file baseline recorded :: (cd / && find bin sbin lib usr etc -xdev -type f ! -path 'etc/dropbear/*' ! -path 'etc/dpkg/*' ! -path 'usr/share/APPLaunch/*' ! -path 'etc/resolv.conf' ! -path 'etc/ld.so.cache' ! -path 'etc/wpa_supplicant.conf' ! -path 'etc/nz-test-app/*' | sort | xargs sha256sum) > /tmp/fw.before; wc -l < /tmp/fw.before
A1 install upstream app (compass 0.2.4) :: apt-get install -y /mnt/m5cardputerzero-compass_0.2.4_m5stack1_arm64.deb && [ "$(dpkg-query -W -f='${Version}' m5cardputerzero-compass)" = 0.2.4 ] && ls /usr/share/APPLaunch/applications/compass.desktop
A2 app binary loads against firmware libraries :: b=$(sed -n 's/^Exec=\([^ ]*\).*/\1/p' /usr/share/APPLaunch/applications/compass.desktop | head -n1); echo "Exec=$b"; ldd "$b" | grep -c 'not found' | grep -qx 0 && ldd "$b" | tr '\n' ' '
A3 upgrade upstream app (compass 0.2.4 -> 1.0.1) :: apt-get install -y /mnt/m5cardputerzero-compass_1.0.1_m5stack1_arm64.deb && [ "$(dpkg-query -W -f='${Version}' m5cardputerzero-compass)" = 1.0.1 ]
A4 install second upstream app with only firmware deps (ir-remote) :: apt-get install -y /mnt/m5cardputerzero-ir-remote_0.1.4_m5stack1_arm64.deb && dpkg-query -W m5cardputerzero-ir-remote
A6 upstream app binary runs on the framebuffer as UID 1000 (ir-remote) :: b=$(sed -n 's/^Exec=//p' /usr/share/APPLaunch/applications/ir-remote.desktop | head -n1); echo "Exec=$b"; (su -s /bin/sh zero -c "cd /usr/share/APPLaunch && LANG=C.UTF-8 exec $b" >/tmp/irremote.log 2>&1 &); sleep 12; p=$(pidof $(basename ${b%% *})); echo "pid=$p"; tail -n 3 /tmp/irremote.log; [ -n "$p" ]
@shot m5-app-ir-remote
A7 stop the app :: killall $(basename $(sed -n 's/^Exec=//p' /usr/share/APPLaunch/applications/ir-remote.desktop | head -n1 | cut -d' ' -f1)); sleep 1; true
L1 install APPLaunch 0.6.105 (upstream postinst runs) :: apt-get install -y /mnt/applaunch_0.6.105-m5stack1_arm64.deb 2>&1 | tail -n 3; [ "$(dpkg-query -W -f='${Version}' applaunch)" = 0.6.105 ]
L2 postinst enabled the user service the offline way :: ls -l /home/zero/.config/systemd/user/default.target.wants/APPLaunch.service && ls -ld /var/cache/APPLaunch
L3 APPLaunch libraries resolve :: ldd /usr/share/APPLaunch/bin/M5CardputerZero-APPLaunch | grep 'not found'; [ "$(ldd /usr/share/APPLaunch/bin/M5CardputerZero-APPLaunch | grep -c 'not found')" = 0 ]
Q1 (emulator substitution) alias the USB keyboard to the board keyboard path; stop the diagnostic UI :: mkdir -p /dev/input/by-path; ln -sf /dev/input/event0 /dev/input/by-path/platform-3f804000.i2c-event; killall getty 2>/dev/null; sleep 3; true
L4 start services like at boot; APPLaunch runs as UID 1000 :: /etc/init.d/S60nz-units start; sleep 25; p=$(nz-unit --user 1000 main-pid APPLaunch.service); echo "pid=$p exe=$(readlink /proc/$p/exe) uid=$(awk '/^Uid:/{print $2}' /proc/$p/status)"; [ "$(readlink /proc/$p/exe)" = /usr/share/APPLaunch/bin/M5CardputerZero-APPLaunch ] && [ "$(awk '/^Uid:/{print $2}' /proc/$p/status)" = 1000 ]
L5 APPLaunch still alive after 20 s (not crash-looping) :: echo 1 > /proc/sys/kernel/print-fatal-signals; p1=$(nz-unit --user 1000 main-pid APPLaunch.service); sleep 20; p2=$(nz-unit --user 1000 main-pid APPLaunch.service); echo "$p1 $p2"; tail -n 5 /run/nz-units/user/APPLaunch.service.log; [ "$p1" = "$p2" ] && [ "$p1" != 0 ]
@shot applaunch-0.6.105-home
@key right
@shot applaunch-0.6.105-right
@key right ret
@sleep 3
@shot applaunch-0.6.105-enter
@key esc
@sleep 2
L6 systemctl shim answers the updater's health checks :: su -s /bin/sh zero -c 'systemctl --user is-active --quiet APPLaunch.service && systemctl --user show APPLaunch.service --property=MainPID --value'
L6b crash count after keyboard navigation (0 expected) :: n=$(grep -c 'Segmentation fault' /run/nz-units/user/APPLaunch.service.log); echo "segfaults so far: $n"; dmesg | grep -A12 'potentially unexpected fatal signal' | grep -E 'fatal signal|pc :|lr :|CPU:' | tail -n 8; [ "$n" = 0 ]
L7 user configuration written before upgrade :: su -s /bin/sh zero -c 'mkdir -p ~/.config/nz-test && echo keep-me > ~/.config/nz-test/user.conf'; echo keep-me > /var/cache/APPLaunch/nz-user-marker; ls -la /home/zero/.config/ | wc -l
L8 upgrade APPLaunch 0.6.105 -> 0.6.106 with dpkg :: apt-get install -y /mnt/applaunch_0.6.106-m5stack1_arm64.deb 2>&1 | tail -n 2; [ "$(dpkg-query -W -f='${Version}' applaunch)" = 0.6.106 ] && dpkg --audit
L9 user configuration preserved across the upgrade :: grep -q keep-me /home/zero/.config/nz-test/user.conf && grep -q keep-me /var/cache/APPLaunch/nz-user-marker && ls /home/zero/.config/systemd/user/default.target.wants/APPLaunch.service
L10 restart picks up the new binary :: systemctl --user >/dev/null 2>&1; echo --restart-marker-- >> /run/nz-units/user/APPLaunch.service.log; nz-unit --user 1000 restart APPLaunch.service; sleep 25; p=$(nz-unit --user 1000 main-pid APPLaunch.service); readlink /proc/$p/exe; [ "$(readlink /proc/$p/exe)" = /usr/share/APPLaunch/bin/M5CardputerZero-APPLaunch ]
@shot applaunch-0.6.106-home
@key right
@shot applaunch-0.6.106-right
@key right ret
@sleep 4
@shot applaunch-0.6.106-enter
@key esc
@sleep 8
L11 crash count for 0.6.106 after the same keyboard navigation (0 expected) :: n=$(sed -n '/^--restart-marker--$/,$p' /run/nz-units/user/APPLaunch.service.log | grep -c 'Segmentation fault'); echo "segfaults since restart: $n"; [ "$n" = 0 ]
T1 lifecycle package install runs postinst, conffile installed :: dpkg -i /mnt/nz-test-app_1.0_arm64.deb && cat /var/lib/nz-test-app/history && grep default-1.0 /etc/nz-test-app/app.conf
T2 user edits conffile; upgrade keeps the edit (non-interactive) :: nz-rw sh -c 'echo "setting=user-edited" > /etc/nz-test-app/app.conf'; dpkg -i /mnt/nz-test-app_2.0_arm64.deb </dev/null && grep user-edited /etc/nz-test-app/app.conf && grep 'version 2.0' /opt/nz-test-app/VERSION && cat /var/lib/nz-test-app/history
T3 downgrade (rollback) to the previous version :: dpkg -i /mnt/nz-test-app_1.0_arm64.deb </dev/null && grep 'version 1.0' /opt/nz-test-app/VERSION && grep user-edited /etc/nz-test-app/app.conf
T4 remove keeps config, purge deletes it :: dpkg -r nz-test-app && [ ! -e /opt/nz-test-app/VERSION ] && [ -e /etc/nz-test-app/app.conf ] && dpkg -P nz-test-app && [ ! -e /etc/nz-test-app/app.conf ] && [ ! -d /var/lib/nz-test-app ]
T5 unmet dependency is refused by apt-get shim and by dpkg :: ! apt-get install -y /mnt/nz-test-needs-debian_1.0_arm64.deb 2>&1 | grep libnonexistent42; ! dpkg -i /mnt/nz-test-needs-debian_1.0_arm64.deb >/tmp/d.log 2>&1; grep -i 'depend' /tmp/d.log | head -n 2; dpkg -P nz-test-needs-debian >/dev/null 2>&1; dpkg --audit
T7 apt-get shim: -s only prints what it would do; an unknown option is refused, not ignored :: apt-get install -y /mnt/nz-test-app_1.0_arm64.deb >/dev/null </dev/null && apt-get -s remove nz-test-app | grep '^Remv nz-test-app' && apt-get -sy remove --purge nz-test-app | grep '^Purg nz-test-app' && ! apt-get --no-such-option remove nz-test-app && [ "$(dpkg-query -W -f='${db:Status-Status}' nz-test-app)" = installed ] && dpkg -P nz-test-app && dpkg --audit
H1 hostile package (ships /bin/busybox, libc, /etc/passwd) is refused; nothing changes :: ! dpkg -i /mnt/nz-test-hostile_1.0_arm64.deb 2>/tmp/h1; sed 's/\x1b\[[0-9;]*m//g' /tmp/h1 | head -n 6; ! grep -q HOSTILE /bin/busybox /lib/libc.so.6 /usr/lib/libstdc++.so.6 && ! grep -q hostile /etc/passwd && [ ! -e /opt/nz-test/marker ] && busybox true
H2 purging the refused package is a no-op; firmware files in place :: dpkg -P nz-test-hostile 2>/dev/null; [ -x /bin/busybox ] && [ -e /lib/libc.so.6 ] && [ -e /etc/passwd ] && busybox true
H3 the firmware package itself cannot be removed :: ! dpkg -r nz-firmware 2>/tmp/h3; head -n 3 /tmp/h3; [ -x /bin/busybox ]
H4 the same package with --force-overwrite / --force-all is refused too :: ! dpkg --force-overwrite -i /mnt/nz-test-hostile_1.0_arm64.deb 2>/tmp/h4; ! dpkg --force-all -i /mnt/nz-test-hostile_1.0_arm64.deb 2>>/tmp/h4; head -n 3 /tmp/h4; dpkg -P nz-test-hostile 2>/dev/null; ! grep -q HOSTILE /bin/busybox /lib/libc.so.6 && [ -e /lib/libc.so.6 ] && [ -x /bin/busybox ] && busybox true
I1 interrupted install (SIGKILL during unpack) is detected :: (dpkg -i /mnt/nz-test-big_1.0_arm64.deb >/tmp/big.log 2>&1 &) ; n=0; while [ $n -lt 600 ] && [ "$(ls /opt/nz-test-big 2>/dev/null | wc -l)" -lt 5 ]; do sleep 0.1; n=$((n+1)); done; killall -9 dpkg dpkg-deb 2>/dev/null; sleep 1; s=$(dpkg-query -W -f='${db:Status-Status}' nz-test-big); echo "status after kill: $s"; dpkg --audit | grep -A2 -i 'half\|unpack' | head -n 4; [ "$s" = half-installed ] || [ "$s" = unpacked ]
I2 recovery: configure pending + reinstall completes :: dpkg --configure -a; dpkg -i /mnt/nz-test-big_1.0_arm64.deb >/dev/null && [ "$(dpkg-query -W -f='${db:Status-Status}' nz-test-big)" = installed ] && dpkg --audit && ls /opt/nz-test-big | wc -l
I3 interrupted upgrade of APPLaunch then recovery (rollback path of the upstream updater) :: (dpkg -i /mnt/applaunch_0.6.105-m5stack1_arm64.deb >/tmp/al.log 2>&1 &) ; n=0; while [ $n -lt 900 ] && ! ls /usr/share/APPLaunch/bin/*.dpkg-new >/dev/null 2>&1; do sleep 0.1; n=$((n+1)); done; killall -9 dpkg dpkg-deb 2>/dev/null; sleep 1; echo "status after kill: $(dpkg-query -W -f='${db:Status-Status} ${Version}' applaunch)"; dpkg --configure -a >/dev/null 2>&1; dpkg -i /mnt/applaunch_0.6.106-m5stack1_arm64.deb >/dev/null 2>&1 && [ "$(dpkg-query -W -f='${db:Status-Status} ${Version}' applaunch)" = "installed 0.6.106" ] && dpkg --audit
U1 uninstall upstream app :: dpkg -r m5cardputerzero-compass && [ ! -e /usr/share/APPLaunch/applications/compass.desktop ] && ! dpkg-query -W -f='${db:Status-Status}' m5cardputerzero-compass 2>/dev/null | grep -qx installed
U2 uninstall APPLaunch (upstream prerm runs) :: dpkg -r applaunch 2>&1 | tail -n 2; [ ! -e /usr/share/APPLaunch/bin/M5CardputerZero-APPLaunch ] && [ ! -e /home/zero/.config/systemd/user/default.target.wants/APPLaunch.service ]
D1 app built with the SDK template (hello_1.0_arm64.deb) installs and gets a launcher entry :: dpkg -i /mnt/hello_1.0_arm64.deb >/dev/null && nz-launcher --list | grep -i hello && file /opt/hello/hello 2>/dev/null | cut -c1-60; [ -x /opt/hello/hello ]
N1 native launcher takes over the LCD once APPLaunch is gone and lists installed .desktop apps :: rm -f /run/nz/nolauncher; killall M5CardputerZero-APPLaunch 2>/dev/null; nz-unit --user 1000 stop APPLaunch.service 2>/dev/null; killall sleep getty 2>/dev/null; sleep 6; pidof nz-launcher && nz-launcher --list | cut -f1,2
@shot nz-launcher-list
@key down down down down down down down
@shot nz-launcher-scrolled
D2 remove the SDK app again :: dpkg -r hello >/dev/null && [ ! -e /usr/share/applications/hello.desktop ]
F1 firmware files identical to the baseline after all of the above :: dpkg -P nz-test-big >/dev/null 2>&1; (cd / && find bin sbin lib usr etc -xdev -type f ! -path 'etc/dropbear/*' ! -path 'etc/dpkg/*' ! -path 'usr/share/APPLaunch/*' ! -path 'etc/resolv.conf' ! -path 'etc/ld.so.cache' ! -path 'etc/wpa_supplicant.conf' ! -path 'etc/nz-test-app/*' | sort | xargs sha256sum) > /tmp/fw.after; diff /tmp/fw.before /tmp/fw.after && echo "$(wc -l < /tmp/fw.after) firmware files unchanged"
F2 dpkg database consistent; only firmware entries and ir-remote remain :: [ -z "$(dpkg --audit)" ] && dpkg-query -W -f='${db:Status-Abbrev}${Package}\n' | grep -v '^hi'; [ "$(dpkg-query -W -f='${db:Status-Abbrev}${Package}\n' | grep -v '^hi' | grep -c '^ii')" = 1 ]
F3 system partition is read-only again once nothing replaced is still running :: n=0; while ! grep -q ' / ext4 ro' /proc/mounts && [ $n -lt 40 ]; do sleep 1; n=$((n+1)); done; grep ' / ext4' /proc/mounts; grep -q ' / ext4 ro' /proc/mounts
